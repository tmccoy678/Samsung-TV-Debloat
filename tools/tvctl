#!/usr/bin/env python3
"""On-demand control for a supported Samsung TU7000; starts no daemon."""

from __future__ import annotations

import argparse
import json
import shlex
import subprocess
import sys
from pathlib import Path

PROJECT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT / "tools"))
from runtime_config import root_executable, tv_host  # noqa: E402
from sdb_direct import SDB as DirectSDB  # noqa: E402

TV_HOST = tv_host()
ROOT_TOOL = root_executable(PROJECT)
SDB = PROJECT / "tools/sdb"
REMOTE = PROJECT / "tools/samsung_remote.py"


def compose_remote_command(arguments: list[str]) -> str:
    """Preserve a quoted command string or safely join separate arguments."""
    if len(arguments) == 1:
        return arguments[0]
    return shlex.join(arguments)


def sdb_capture(command: str, timeout: float = 30) -> str:
    client = DirectSDB(TV_HOST, timeout=timeout)
    try:
        client.open_stream(f"shell:0 {command}")
        output = client.read_stream().decode("utf-8", "replace")
    finally:
        client.close()
    if "\n[exit:0]" not in output:
        raise RuntimeError(output.strip())
    return output.split("\n[exit:0]", 1)[0].rstrip()


def run_root(command: str, command_timeout: int = 180) -> int:
    arguments = [
        str(ROOT_TOOL),
        "--output",
        "json",
        "--sdb",
        str(SDB),
        "archive-root",
        "root",
        TV_HOST,
        "--accept-timeout",
        "30",
        "--command-timeout",
        str(command_timeout),
        "--command",
        command,
    ]
    completed = subprocess.run(
        arguments,
        cwd=PROJECT,
        capture_output=True,
        text=True,
        timeout=command_timeout + 90,
        check=False,
    )
    if completed.returncode:
        if completed.stderr:
            print(completed.stderr.rstrip(), file=sys.stderr)
        return completed.returncode
    result = json.loads(completed.stdout)
    if not result.get("authenticated") or result.get("uid") != 0:
        raise RuntimeError("TV root session did not authenticate as UID 0")
    commands = result.get("commands", [])
    if len(commands) != 1:
        raise RuntimeError("TV root session returned an unexpected command count")
    outcome = commands[0]
    stdout = outcome.get("stdout")
    stderr = outcome.get("stderr")
    if stdout:
        print(str(stdout).rstrip())
    if stderr:
        print(str(stderr).rstrip(), file=sys.stderr)
    return int(outcome.get("exit_code", 1))


def run_remote(*arguments: str) -> int:
    return subprocess.run(
        [sys.executable, str(REMOTE), *arguments], check=False
    ).returncode


def status() -> int:
    command = r'''
echo BOOT_ID
cat /proc/sys/kernel/random/boot_id
echo HOOK_STATUS
cat /opt/usr/share/daybreak-tv-guard/boot-hook.status 2>&1 || true
echo ROOT_STATUS
cat /opt/usr/share/daybreak-tv-guard/root-status.log 2>&1 || true
echo WORKER
systemctl show daybreak-tv-root-guard-worker.service -p ActiveState -p SubState -p Result -p ExecMainStatus 2>&1 || true
'''.strip()
    print(sdb_capture(command))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest="action", required=True)
    actions.add_parser("status", help="show live guard and worker status")
    for action in ("shell", "root"):
        command_parser = actions.add_parser(action, help=f"run an on-demand {action} command")
        command_parser.add_argument("command", nargs=argparse.REMAINDER)
    key_parser = actions.add_parser("key", help="send a Samsung remote key")
    key_parser.add_argument("key_name")
    launch_parser = actions.add_parser("launch", help="launch a Samsung app ID")
    launch_parser.add_argument("app_id")
    actions.add_parser("pair", help="authorize or refresh the Keychain token")
    actions.add_parser("poweroff", help="send a held power-button press")
    actions.add_parser("debloat", help="run both TV-local cleanup passes now")
    args = parser.parse_args()

    if args.action == "status":
        return status()
    if args.action in ("shell", "root"):
        if not args.command:
            parser.error(f"{args.action} requires a command")
        command = compose_remote_command(args.command)
        if args.action == "shell":
            print(sdb_capture(command))
            return 0
        return run_root(command)
    if args.action == "debloat":
        return run_root(
            "DAYBREAK_INITIAL_DELAY_SECONDS=0 "
            "DAYBREAK_SETTLE_DELAY_SECONDS=0 "
            "DAYBREAK_PASS_DELAY_SECONDS=0 "
            "sh -s</opt/usr/share/daybreak-tv-guard/root-enforce.sh"
        )
    if args.action == "key":
        return run_remote("key", args.key_name)
    if args.action == "launch":
        return run_remote("launch", args.app_id)
    return run_remote(args.action)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        print(f"tvctl: {error}", file=sys.stderr)
        raise SystemExit(1)
